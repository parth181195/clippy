<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
      Hardened Runtime + Developer ID signing path (issue #5).

      App Sandbox is NOT enabled — we'd lose clipboard reads from any app,
      paste-as-keystroke into other apps, and global hotkeys. This is the
      direct-download-only model documented in
      docs/cross-platform-support-prd.md §2 non-goals.
    -->

    <!-- Required for Electron's V8 + JIT. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>

    <!--
      Send Apple Events to System Events for paste-as-keystroke. The user
      grants this the first time we call osascript (Privacy → Automation).
    -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>

    <!--
      Allow loading native modules (better-sqlite3, dbus-next isn't loaded
      on Mac but stays resolvable). Hardened Runtime blocks unsigned
      dynamic libraries by default.
    -->
    <key>com.apple.security.cs.allow-dyld-environment-variables</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>

{
  "name": "clippy",
  "version": "0.3.1",
  "description": "LAN-only clipboard manager",
  "author": {
    "name": "Parth",
    "email": "parthjansari@outlook.com"
  },
  "homepage": "https://github.com/parth181195/clippy",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -p tsconfig.electron.json",
    "start": "cross-env ELECTRON_OZONE_PLATFORM_HINT=x11 electron . --no-sandbox",
    "electron:dev": "concurrently -k -n vite,electron -c cyan,magenta \"vite\" \"wait-on tcp:5174 && tsc -p tsconfig.electron.json --watch & cross-env ELECTRON_OZONE_PLATFORM_HINT=x11 electron . --no-sandbox\"",
    "electron:run": "tsc -p tsconfig.electron.json && cross-env ELECTRON_OZONE_PLATFORM_HINT=x11 electron . --no-sandbox",
    "package": "node scripts/stage-extension.mjs && vite build && tsc -p tsconfig.electron.json && electron-builder",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "postinstall": "electron-rebuild -f -w better-sqlite3"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-switch": "^1.2.6",
    "@sentry/electron": "^7.13.0",
    "better-sqlite3": "^11.3.0",
    "bonjour-service": "^1.4.0",
    "dbus-next": "^0.10.2",
    "libsodium-wrappers": "^0.8.4",
    "lucide-react": "^1.16.0",
    "node-notifier": "^10.0.1",
    "play-sound": "^1.1.6",
    "qrcode": "^1.5.4",
    "uuid": "^14.0.0",
    "ws": "^8.21.0",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@resvg/resvg-js": "^2.6.2",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.0.1",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.7.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.2",
    "concurrently": "^9.0.1",
    "cross-env": "^10.1.0",
    "electron": "^32.1.2",
    "electron-builder": "^25.0.5",
    "jsdom": "^25.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "io.clippy.app",
    "productName": "Clippy",
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "assets/**/*"
    ],
    "extraResources": [
      {
        "from": "extension-bundle",
        "to": "gnome-extension"
      }
    ],
    "directories": {
      "output": "release"
    },
    "linux": {
      "target": [
        "deb"
      ],
      "category": "Utility",
      "icon": "assets/icons",
      "executableArgs": ["--no-sandbox"]
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": ["universal"]
        }
      ],
      "icon": "assets/icons/icon.png",
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "LSUIElement": true,
        "NSAppleEventsUsageDescription": "Clippy uses System Events to paste your selected clip into the active app."
      }
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "assets/icons/icon.png",
      "signtoolOptions": {
        "signingHashAlgorithms": ["sha256"]
      }
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Clippy"
    }
  }
}

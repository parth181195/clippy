---
import Logo from './Logo.astro';

const REPO = 'https://github.com/parth181195/clippy';
const cols = [
  { title: 'Product', items: [['Features', '#features'], ['Privacy', '#privacy'], ['Hotkeys', '#hotkeys'], ['What ships', '#compare']] },
  { title: 'Download', items: [['Ubuntu .deb', `${REPO}/releases/download/v0.1.0/clippy_0.1.0_amd64.deb`], ['Android APK', `${REPO}/releases/download/v0.1.0/clippy-0.1.0.apk`], ['GNOME extension', `${REPO}/tree/main/extension`]] },
  { title: 'Project', items: [['GitHub', REPO], ['Report an issue', `${REPO}/issues`], ['License (GPLv3)', `${REPO}/blob/main/LICENSE`]] },
];
---
<footer class="footer" id="github">
  <div class="wrap">
    <div class="top">
      <div class="brand">
        <Logo size={20} />
        <p>A clipboard manager that takes copy-paste seriously. Free, local-first, open source.</p>
        <div class="tag mono">LAN-only · no cloud · no account</div>
      </div>
      {cols.map((c) => (
        <div class="col">
          <div class="ct mono">{c.title.toUpperCase()}</div>
          <div class="links">
            {c.items.map(([label, href]) => (
              <a href={href} target={href.startsWith('http') ? '_blank' : undefined} rel={href.startsWith('http') ? 'noopener' : undefined}>{label}</a>
            ))}
          </div>
        </div>
      ))}
    </div>
    <div class="bottom">
      <div class="mono">© 2026 Clippy · GPL-3.0</div>
      <div class="status mono">
        <span>v0.1.0</span>
        <span class="sep">·</span>
        <span class="beta"><span class="bdot"></span> open beta</span>
      </div>
    </div>
  </div>
</footer>
<style>
  .footer { padding: 80px 40px 40px; border-top: 1px solid var(--border-subtle); background: #0A0A11; }
  .top { display: grid; grid-template-columns: 1.6fr repeat(3, 1fr); gap: 48px; }
  .brand p { margin: 16px 0 0; font-size: 13px; color: var(--text-secondary); line-height: 1.5; max-width: 260px; }
  .tag { margin-top: 20px; font-size: 11px; color: var(--text-tertiary); }
  .ct { font-size: 11px; font-weight: 700; letter-spacing: 1.2px; color: var(--text-tertiary); margin-bottom: 16px; }
  .links { display: flex; flex-direction: column; gap: 10px; }
  .links a { font-size: 13px; color: var(--text-secondary); }
  .links a:hover { color: var(--text); }
  .bottom { margin-top: 60px; padding-top: 24px; border-top: 1px solid var(--border-subtle); display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap; }
  .bottom, .status { font-size: 12px; color: var(--text-tertiary); }
  .status { display: flex; gap: 12px; align-items: center; }
  .beta { display: inline-flex; align-items: center; gap: 5px; }
  .bdot { width: 6px; height: 6px; border-radius: 3px; background: var(--accent); }
  @media (max-width: 900px) { .top { grid-template-columns: 1fr 1fr; gap: 32px; } }
  @media (max-width: 640px) { .footer { padding: 60px 20px 40px; } .top { grid-template-columns: 1fr; } }
</style>

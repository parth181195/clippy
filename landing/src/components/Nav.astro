---
import Logo from './Logo.astro';
import Button from './Button.astro';
---
<nav class="nav">
  <div class="wrap nav-inner">
    <a href="#top"><Logo /></a>
    <div class="links hide-sm">
      <a href="#features">Features</a>
      <a href="#privacy">Privacy</a>
      <a href="#compare">Compare</a>
      <a href="#hotkeys">Hotkeys</a>
      <a href="https://github.com/parth181195/clippy" target="_blank" rel="noopener">GitHub</a>
    </div>
    <div class="spacer"></div>
    <span class="badge hide-sm">v0.1 · open beta</span>
    <Button href="#download">Download</Button>
  </div>
</nav>
<style>
  .nav {
    position: sticky; top: 0; z-index: 50;
    background: rgba(14, 14, 21, 0.7);
    backdrop-filter: blur(16px) saturate(140%);
    border-bottom: 1px solid var(--border-subtle);
  }
  .nav-inner { display: flex; align-items: center; gap: 32px; padding: 14px 40px; }
  .links { display: flex; gap: 24px; font-size: 13px; color: var(--text-secondary); font-weight: 500; }
  .links a:hover { color: var(--text); }
  .spacer { flex: 1; }
  .badge {
    font-size: 11px; padding: 4px 9px; border-radius: 7px;
    background: rgba(233, 86, 120, 0.13); color: var(--accent);
    font-weight: 600; letter-spacing: 0.4px; text-transform: uppercase; white-space: nowrap;
  }
  @media (max-width: 640px) { .nav-inner { padding: 12px 20px; } }
</style>

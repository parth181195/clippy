---
interface Props { size?: number; }
const { size = 18 } = Astro.props;
---
<span class="logo" style={`--s:${size}px`}>
  <svg width={size * 1.1} height={size * 1.1} viewBox="0 0 24 24" fill="none">
    <rect x="2" y="6" width="20" height="16" rx="3" fill="var(--accent)" />
    <rect x="9" y="3" width="6" height="4" rx="1.5" fill="var(--text)" />
    <line x1="7" y1="12" x2="17" y2="12" stroke="var(--bg)" stroke-width="1.6" stroke-linecap="round" />
    <line x1="7" y1="16" x2="13" y2="16" stroke="var(--bg)" stroke-width="1.6" stroke-linecap="round" />
  </svg>
  <span class="word">Clippy</span>
</span>
<style>
  .logo { display: inline-flex; align-items: center; gap: 8px; }
  .word { font-size: var(--s); font-weight: 700; letter-spacing: -0.4px; color: var(--text); }
</style>

---
import Button from './Button.astro';
import Icon from './Icon.astro';
---
<section class="cta" id="download">
  <div class="glow"></div>
  <div class="inner">
    <h2>A few hundred clips a day.<br /><span class="accent">Stop losing them.</span></h2>
    <p>Clippy is free and open source. Invite-only while it&apos;s in beta — grab a build below.</p>
    <div class="ctas">
      <Button primary large href="/downloads/clippy_0.1.0_amd64.deb"><Icon name="download" size={16} /> Download for Ubuntu</Button>
      <Button ghost large href="/downloads/clippy-0.1.0.apk">Get on Android</Button>
    </div>
    <div class="meta mono">Ubuntu 22.04+ · ~78 MB .deb · Android APK · GPLv3</div>
  </div>
</section>
<style>
  .cta { position: relative; overflow: hidden; padding: 180px 40px 140px; text-align: center; }
  .glow { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 1200px; height: 600px; pointer-events: none; background: radial-gradient(ellipse 50% 40% at 50% 50%, rgba(233, 86, 120, 0.27) 0%, transparent 70%); }
  .inner { position: relative; max-width: 900px; margin: 0 auto; }
  h2 { margin: 0; font-size: clamp(48px, 7vw, 88px); font-weight: 700; line-height: 0.98; letter-spacing: -2.4px; }
  .accent { color: var(--accent); font-style: italic; }
  p { margin: 28px auto 0; max-width: 540px; font-size: 18px; line-height: 1.5; color: var(--text-secondary); }
  .ctas { margin-top: 40px; display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }
  .meta { margin-top: 20px; font-size: 12px; color: var(--text-tertiary); }
  @media (max-width: 640px) { .cta { padding: 120px 20px 100px; } }
</style>

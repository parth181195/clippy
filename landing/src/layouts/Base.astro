---
import '../styles/global.css';
const title = 'Clippy — a clipboard manager that takes copy-paste seriously';
const desc =
  'A LAN-only clipboard manager + small-file sharer for Ubuntu and Android. Remembers every clip, searches them all, and syncs to your phone — no cloud, no account.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={desc} />
    <link rel="icon" type="image/svg+xml" href="/icon.svg" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={desc} />
    <meta property="og:image" content="/icon.png" />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#0E0E15" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700;800&family=Geist+Mono:wght@400;500&display=swap"
    />
  </head>
  <body>
    <slot />
  </body>
</html>
